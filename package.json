{
  "name": "prism",
  "private": true,
  "version": "1.5.30",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src scripts marbles/src coloring/src coloring/scripts",
    "test": "node --test src/game/*.test.js marbles/src/game/*.test.js coloring/src/*.test.js",
    "levels": "node scripts/generate-levels.mjs",
    "events": "node scripts/generate-events.mjs",
    "ios": "vite build && cap sync ios",
    "pals:fit": "node scripts/fit-pals.cjs",
    "marbles": "vite --config marbles/vite.config.js",
    "coloring": "vite --config coloring/vite.config.js",
    "coloring:pages": "node coloring/scripts/make-pages.mjs",
    "coloring:check": "node coloring/scripts/check.cjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capgo/native-purchases": "^8.9.17",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "@supabase/supabase-js": "^2.119.0",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.93.0",
    "vite": "^8.3.8"
  }
}
